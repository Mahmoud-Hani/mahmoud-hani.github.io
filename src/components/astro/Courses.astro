---
import { portfolioData } from "../../data/portfolio";
import SectionHeader from "./SectionHeader.astro";
import { BookOpen } from "lucide-astro";

const { courses } = portfolioData;
---

<section id="courses" class="py-20 sm:py-28 border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      number="06"
      title="Completed Courses & Bootcamps"
      subtitle="Completed specialized technical courses and security bootcamps."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        courses.map((course) => (
          <div class="rounded-xl bg-card border border-border-subtle p-5 hover:border-accent-blue/30 transition-colors group flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-text-muted mb-2">
                <span>{course.date}</span>
                <span class="text-accent-teal font-semibold px-2 py-0.5 rounded bg-accent-teal/10">{course.duration}</span>
              </div>
              <h3 class="text-sm font-semibold text-text-primary group-hover:text-accent-blue transition-colors leading-snug">
                {course.title}
              </h3>
            </div>
            <p class="text-xs text-text-dark mt-3 font-mono pt-2 border-t border-border-subtle/50">
              {course.provider}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
