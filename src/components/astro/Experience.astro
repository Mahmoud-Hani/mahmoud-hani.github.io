---
import { portfolioData } from "../../data/portfolio";
import SectionHeader from "./SectionHeader.astro";

const { experience } = portfolioData;
---

<section id="experience" class="py-20 sm:py-28 border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      number="07"
      title="Experience & Training Timeline"
      subtitle="Structured cybersecurity training programs, security mentorships, and educational roles."
    />

    <!-- Timeline -->
    <div class="space-y-8 relative before:absolute before:inset-0 before:left-4 md:before:left-8 before:w-0.5 before:bg-border-subtle">
      {
        experience.map((exp) => (
          <div class="relative flex items-start gap-4 md:gap-8 group">
            <!-- Timeline Node -->
            <div class="w-8 md:w-16 flex justify-center shrink-0 pt-1.5 z-10">
              <div class="w-3.5 h-3.5 rounded-full bg-secondary border-2 border-accent-blue group-hover:scale-125 group-hover:bg-accent-blue transition-all duration-300"></div>
            </div>

            <!-- Timeline Content Card -->
            <div class="flex-1 rounded-2xl bg-card border border-border-subtle p-6 sm:p-8 space-y-4 hover:border-accent-blue/30 transition-all duration-300 shadow-md">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border-subtle pb-4">
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="font-mono text-xs font-bold text-accent-blue uppercase">
                      {exp.id}
                    </span>
                    <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-semibold uppercase bg-secondary text-accent-teal border border-border-subtle">
                      {exp.typeLabel}
                    </span>
                    {exp.score && (
                      <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-semibold text-accent-blue bg-accent-blue/10 border border-accent-blue/20">
                        Score: {exp.score}
                      </span>
                    )}
                    {exp.hours && (
                      <span class="px-2.5 py-0.5 rounded text-[10px] font-mono text-text-muted bg-secondary">
                        {exp.hours}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-text-primary">
                    {exp.role}
                  </h3>
                  <p class="text-sm text-text-secondary font-medium mt-0.5">
                    {exp.organization} • <span class="text-text-muted font-mono text-xs">{exp.mode}</span>
                  </p>
                </div>

                <div class="sm:text-right font-mono text-xs text-accent-blue font-medium">
                  {exp.startDate} – {exp.endDate}
                </div>
              </div>

              <!-- Descriptions -->
              <div class="space-y-2 text-sm text-text-secondary leading-relaxed">
                {
                  exp.description.map((desc) => (
                    <p>{desc}</p>
                  ))
                }
              </div>

              <!-- Multi-stage cards -->
              {exp.stages && (
                <div class="space-y-3 pt-2">
                  <span class="font-mono text-xs uppercase tracking-wider text-text-muted block">
                    Training Stages:
                  </span>
                  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    {
                      exp.stages.map((stg) => (
                        <div class="p-3.5 rounded-lg bg-secondary border border-border-subtle/80 space-y-1.5">
                          <div class="flex items-center justify-between text-xs font-mono text-accent-teal font-semibold">
                            <span>{stg.hours}</span>
                          </div>
                          <h4 class="text-xs font-semibold text-text-primary leading-snug">
                            {stg.title}
                          </h4>
                          {stg.topics && (
                            <div class="flex flex-wrap gap-1 pt-1">
                              {
                                stg.topics.map((top) => (
                                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-primary/80 text-text-muted">
                                    {top}
                                  </span>
                                ))
                              }
                            </div>
                          )}
                        </div>
                      ))
                    }
                  </div>
                </div>
              )}

              <!-- Specific Curriculum Focus -->
              {exp.topics && !exp.stages && (
                <div class="pt-2">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-text-muted block mb-1.5">
                    Curriculum Focus:
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {
                      exp.topics.map((top) => (
                        <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-secondary text-text-secondary border border-border-subtle">
                          {top}
                        </span>
                      ))
                    }
                  </div>
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
