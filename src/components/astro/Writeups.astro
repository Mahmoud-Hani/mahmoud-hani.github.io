---
import { portfolioData } from "../../data/portfolio";
import SectionHeader from "./SectionHeader.astro";

const { writeups } = portfolioData;
---

<section id="writeups" class="py-20 sm:py-28 border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      number="08"
      title="Writeups & Technical Reports"
      subtitle="Security intelligence reports, technical assessments, and walkthrough documentation."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        writeups.placeholder.map((ph, idx) => (
          <div class="rounded-xl bg-card border border-dashed border-border-subtle p-6 flex items-center justify-between hover:border-accent-blue/30 transition-colors">
            <div class="space-y-1">
              <span class="font-mono text-[10px] text-text-dark tracking-wider uppercase">
                INTEL-DOC-0{idx + 1}
              </span>
              <h3 class="text-sm font-medium text-text-muted">{ph}</h3>
            </div>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-mono text-accent-teal bg-accent-teal/10 border border-accent-teal/20 font-semibold">
              PENDING
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
