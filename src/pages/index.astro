---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/astro/Navbar.astro";
import Hero from "../components/react/Hero";
import About from "../components/astro/About.astro";
import Skills from "../components/astro/Skills.astro";
import SectionHeader from "../components/astro/SectionHeader.astro";
import Methodology from "../components/react/Methodology";
import Projects from "../components/react/Projects";
import Labs from "../components/astro/Labs.astro";
import Certifications from "../components/astro/Certifications.astro";
import Courses from "../components/astro/Courses.astro";
import Experience from "../components/astro/Experience.astro";
import Volunteering from "../components/astro/Volunteering.astro";
import Writeups from "../components/astro/Writeups.astro";
import ContactForm from "../components/react/ContactForm";
import Footer from "../components/astro/Footer.astro";
import LinkedinIcon from "../components/icons/Linkedin.astro";
import GithubIcon from "../components/icons/Github.astro";

import { portfolioData } from "../data/portfolio";
import { Mail, Phone, ExternalLink } from "lucide-astro";

const { identity } = portfolioData;
---

<BaseLayout>
  <!-- Navigation Header Island -->
  <Navbar />

  <main id="main-content" class="flex-grow">
    <!-- 00. Hero Section Island -->
    <Hero client:load />

    <!-- 01. About & Security Profile -->
    <About />

    <!-- 02. Technical Skills & Tooling -->
    <Skills />

    <!-- 03. Security Testing Methodology -->
    <section id="methodology" class="py-20 sm:py-28 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          number="03"
          title="Security Testing Methodology"
          subtitle="Conceptual 8-stage penetration testing lifecycle modeled after industry security assessment frameworks."
        />

        <Methodology client:visible />
      </div>
    </section>

    <!-- 04. Security Projects & Case Files -->
    <section id="projects" class="py-20 sm:py-28 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          number="04"
          title="Security Projects & Case Files"
          subtitle="Practical security labs and vulnerability testing scenarios."
        />

        <Projects client:visible />

        <!-- Practical Labs & CTF Experience -->
        <Labs />
      </div>
    </section>

    <!-- 05. Certifications -->
    <Certifications />

    <!-- 06. Courses & Bootcamps -->
    <Courses />

    <!-- 07. Experience & Training Timeline -->
    <section id="experience-wrapper">
      <Experience />
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <Volunteering />
      </div>
    </section>

    <!-- 08. Writeups & Threat Intel Reports -->
    <Writeups />

    <!-- 09. Contact Section -->
    <section id="contact" class="py-20 sm:py-28 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          number="09"
          title="Let's Talk Security"
          subtitle="Open to Junior Penetration Tester and Security Analyst opportunities."
        />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Contact Details Cards -->
          <div class="lg:col-span-5 space-y-4">
            <p class="text-text-secondary text-sm sm:text-base leading-relaxed mb-6">
              I am actively looking for Junior Penetration Tester and Security Analyst opportunities. Reach out directly via email, phone, or LinkedIn to connect.
            </p>

            <a
              href={`mailto:${identity.email}`}
              class="rounded-xl bg-card border border-border-subtle p-5 flex items-center gap-4 hover:border-accent-blue/40 transition-all group block shadow-sm focus-visible:ring-2 focus-visible:ring-accent-blue"
              aria-label={`Send email to ${identity.email}`}
            >
              <div class="p-3 rounded-lg bg-secondary text-accent-blue group-hover:scale-110 transition-transform">
                <Mail class="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="space-y-0.5">
                <span class="font-mono text-[10px] text-text-dark uppercase tracking-wider block">
                  Direct Email
                </span>
                <span class="text-sm font-semibold text-text-primary group-hover:text-accent-blue transition-colors break-all">
                  {identity.email}
                </span>
              </div>
            </a>

            <a
              href={`tel:${identity.phone}`}
              class="rounded-xl bg-card border border-border-subtle p-5 flex items-center gap-4 hover:border-accent-blue/40 transition-all group block shadow-sm focus-visible:ring-2 focus-visible:ring-accent-blue"
              aria-label={`Call ${identity.phone}`}
            >
              <div class="p-3 rounded-lg bg-secondary text-accent-blue group-hover:scale-110 transition-transform">
                <Phone class="w-5 h-5" aria-hidden="true" />
              </div>
              <div class="space-y-0.5">
                <span class="font-mono text-[10px] text-text-dark uppercase tracking-wider block">
                  Phone
                </span>
                <span class="text-sm font-semibold text-text-primary group-hover:text-accent-blue transition-colors">
                  {identity.phone}
                </span>
              </div>
            </a>

            <a
              href={identity.linkedIn}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl bg-card border border-border-subtle p-5 flex items-center gap-4 hover:border-accent-blue/40 transition-all group block shadow-sm focus-visible:ring-2 focus-visible:ring-accent-blue"
              aria-label="Connect with Mahmoud Hany Atlam on LinkedIn (opens in new tab)"
            >
              <div class="p-3 rounded-lg bg-secondary text-accent-blue group-hover:scale-110 transition-transform">
                <LinkedinIcon class="w-5 h-5" />
              </div>
              <div class="space-y-0.5">
                <span class="font-mono text-[10px] text-text-dark uppercase tracking-wider block">
                  LinkedIn Profile
                </span>
                <span class="text-sm font-semibold text-text-primary group-hover:text-accent-blue transition-colors flex items-center gap-1">
                  linkedin.com/in/mahmoud-hany-atlam
                  <ExternalLink class="w-3.5 h-3.5 ml-1" aria-hidden="true" />
                </span>
              </div>
            </a>

            {identity.github && (
              <a
                href={identity.github}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl bg-card border border-border-subtle p-5 flex items-center gap-4 hover:border-accent-blue/40 transition-all group block shadow-sm focus-visible:ring-2 focus-visible:ring-accent-blue"
                aria-label="View Mahmoud Hany Atlam on GitHub (opens in new tab)"
              >
                <div class="p-3 rounded-lg bg-secondary text-accent-blue group-hover:scale-110 transition-transform">
                  <GithubIcon class="w-5 h-5" />
                </div>
                <div class="space-y-0.5">
                  <span class="font-mono text-[10px] text-text-dark uppercase tracking-wider block">
                    GitHub Profile
                  </span>
                  <span class="text-sm font-semibold text-text-primary group-hover:text-accent-blue transition-colors flex items-center gap-1">
                    github.com/Mahmoud-Hanyi
                    <ExternalLink class="w-3.5 h-3.5 ml-1" aria-hidden="true" />
                  </span>
                </div>
              </a>
            )}
          </div>

          <!-- Contact Form Island -->
          <div class="lg:col-span-7">
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <Footer />
</BaseLayout>
